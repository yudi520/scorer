.header {
  text-align: center;
  padding: 60rpx 0;
}

.connection-status {
  background-color: #fff3cd;
  padding: 20rpx;
  text-align: center;
}

.status-text {
  color: #856404;
  font-size: 26rpx;
}

.title {
  display: block;
  font-size: 60rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.action-section {
  padding: 0 40rpx;
  margin-bottom: 60rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 34rpx;
  margin-bottom: 30rpx;
  border: none;
}

.btn-secondary {
  background-color: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 34rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
}

.recent-section {
  padding: 0 30rpx;
  margin-bottom: 60rpx;
}

.room-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.room-item:last-child {
  border-bottom: none;
}

.room-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.room-code {
  font-size: 26rpx;
  color: #999;
}

.tips-section {
  padding: 30rpx;
  background-color: #f0f7ff;
  border-radius: 16rpx;
  margin: 0 30rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.tips-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 40rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 20rpx 0;
  font-size: 30rpx;
  border-radius: 40rpx;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.btn-confirm {
  background-color: #1890ff;
  color: #fff;
  margin-left: 20rpx;
}
