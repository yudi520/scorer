page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 30rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.btn-success {
  background-color: #52c41a;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.input-field {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e8e8e8;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}
